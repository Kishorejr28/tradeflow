VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_RESEND_API_KEY=your_resend_api_key

# Bot API — set these in Vercel after setting up Ngrok
# VITE_BOT_API_URL = your ngrok HTTPS URL e.g. https://xxxx.ngrok-free.app
# VITE_BOT_API_KEY = same key as BOT_API_KEY in trading_bot/.env
VITE_BOT_API_URL=http://localhost:8000
VITE_BOT_API_KEY=your_bot_api_key
